---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import SocialLinks from './SocialLinks.astro';
import Stat from './Stat.astro';
import { stats } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="border-b border-rule">
  <div
    class="shell grid grid-cols-[2rem_1fr] items-end gap-x-4 lg:grid-cols-[3rem_1fr_minmax(0,22rem)]"
  >
    <!-- Left gutter: empty rule column, the Swiss signature. -->
    <div class="self-stretch border-r border-rule" aria-hidden="true"></div>

    <div class="flex flex-col justify-between py-10 pl-2 sm:py-14 lg:pl-10">
      <div class="reveal flex gap-8 sm:gap-12">
        {stats.map((s) => <Stat value={s.value} label={s.label[lang]} />)}
      </div>

      <div class="reveal mt-10 sm:mt-14">
        <h1 class="display">{t('hero.greeting')}</h1>
        <p class="mt-3 text-sm text-muted sm:text-base">{t('hero.tagline')}</p>
      </div>

      <div class="reveal mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 sm:mt-14">
        <SocialLinks variant="inline" />
      </div>
    </div>

    <!-- Portrait bleeds off the bottom edge. -->
    <div class="col-span-2 -mx-6 self-end sm:-mx-10 lg:col-span-1 lg:mx-0">
      <Image
        src={portrait}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 26rem, 100vw"
        class="mx-auto max-h-[46vh] w-full object-contain object-bottom contrast-110 sm:max-h-[54vh] sm:max-w-sm lg:max-h-[68vh] lg:max-w-none"
        loading="eager"
      />
    </div>
  </div>
</div>
