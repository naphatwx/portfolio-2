---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import Stat from './Stat.astro';
import { stats } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="border-b border-rule">
  <div
    class="mx-auto grid max-w-7xl grid-cols-[2rem_1fr] items-end gap-x-4 px-6 sm:px-10 lg:grid-cols-[3rem_1fr_minmax(0,30rem)]"
  >
    <!-- Left gutter: rotated microtext, the Swiss signature. -->
    <div class="flex flex-col items-center justify-between self-stretch border-r border-rule py-10">
      <p class="gutter-text label">{t('hero.role')}</p>
      <span class="my-6 w-px flex-1 bg-rule" aria-hidden="true"></span>
      <p class="gutter-text label">{t('hero.year')}</p>
    </div>

    <div class="flex flex-col justify-between py-14 pl-2 sm:py-20 lg:pl-10">
      <div class="reveal flex gap-10 sm:gap-16">
        {stats.map((s) => <Stat value={s.value} label={s.label[lang]} />)}
      </div>

      <div class="reveal mt-16 sm:mt-24">
        <h1 class="display">{t('hero.greeting')}</h1>
        <p class="mt-4 text-sm text-muted sm:text-base">{t('hero.tagline')}</p>
      </div>

      <a
        href={`${localizePath('/', lang)}#work`}
        class="reveal mt-16 inline-flex items-center gap-2 self-start text-sm text-muted transition-colors hover:text-fg sm:mt-24"
      >
        {t('hero.scroll')}<span aria-hidden="true">↓</span>
      </a>
    </div>

    <!-- Portrait is pre-greyscaled; it bleeds off the bottom edge. -->
    <div class="col-span-2 -mx-6 self-end sm:-mx-10 lg:col-span-1 lg:mx-0">
      <Image
        src={portrait}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 30rem, 100vw"
        class="mx-auto w-full contrast-110 sm:max-w-md lg:max-w-none"
        loading="eager"
      />
    </div>
  </div>
</div>
