---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { experience, person } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = experience[0];
---

<section class="border-b border-rule" aria-labelledby="hero-name">
  <div class="shell grid items-end gap-x-10 lg:grid-cols-[1fr_minmax(0,19rem)]">
    <div class="py-10 sm:py-12 lg:py-16">
      <h1 id="hero-name" class="display">
        {person.displayName[lang].map((part) => <span class="block">{part}</span>)}
      </h1>
      <p class="mt-5 max-w-xl text-xl leading-snug tracking-tight sm:text-2xl">{t('hero.headline')}</p>

      <p class="mt-4 text-sm text-muted">
        <span class="mr-2 inline-block size-1.5 rounded-full bg-accent align-middle" aria-hidden="true"></span>
        {t('hero.roleAt', { role: current.title[lang], company: current.company })} · {t('hero.location')}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <div class="flex flex-wrap gap-2">
          <a
            href={`mailto:${person.email}`}
            class="inline-flex h-9 items-center gap-2 bg-accent px-4 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
          >
            <Icon id="mail" class="size-4" />
            {t('hero.emailMe')}
          </a>
          {person.cv?.[lang] && (
            <a
              href={person.cv[lang]}
              download
              class="inline-flex h-9 items-center gap-2 border border-rule px-4 text-sm font-medium transition-colors hover:border-fg"
            >
              {t('hero.cv')}
            </a>
          )}
        </div>
        <SocialLinks variant="inline" />
      </div>
    </div>

    <!-- Portrait bleeds off the bottom edge. -->
    <div class="-mx-6 self-end sm:-mx-10 lg:mx-0">
      <Image
        src={portrait}
        alt={t('hero.portraitAlt')}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 19rem, 100vw"
        class="mx-auto max-h-[42vh] w-full object-contain object-bottom sm:max-h-[50vh] sm:max-w-sm lg:max-h-[64vh] lg:max-w-none"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
