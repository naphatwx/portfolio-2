---
// UI glyphs in one 1.5 stroke. Brand marks live in SocialIcon.astro.
interface Props {
  id: 'arrow-up-right' | 'arrow-up' | 'menu' | 'mail' | 'copy' | 'sun' | 'moon';
  class?: string;
}
const { id, class: className = 'size-4' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
  {id === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {id === 'arrow-up' && <path d="M12 19V5M6 11l6-6 6 6" />}
  {id === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {id === 'mail' && (
    <>
      <rect x="2.5" y="4.5" width="19" height="15" />
      <path d="m2.5 6 9.5 7 9.5-7" />
    </>
  )}
  {id === 'copy' && (
    <>
      <rect x="8.5" y="8.5" width="12" height="12" />
      <path d="M15.5 8.5v-5h-12v12h5" />
    </>
  )}
  {id === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
    </>
  )}
  {id === 'moon' && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
</svg>
