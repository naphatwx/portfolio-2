---
import Icon from './Icon.astro';
import type { Project } from '../data/site';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="grid gap-3 border-t border-rule py-7 lg:grid-cols-[7rem_1fr] lg:gap-10">
  <p class="label lg:pt-2">{project.year}</p>

  <div>
    <h3 class="text-xl font-medium tracking-tight sm:text-2xl">
      {project.href ? (
        <a href={project.href} target="_blank" rel="noopener" class="group inline-flex items-baseline gap-2 hover:underline">
          {project.title[lang]}
          <Icon id="arrow-up-right" class="size-4 self-center text-muted group-hover:text-fg" />
          <span class="sr-only">{t('projects.visit')} {t('a11y.newTab')}</span>
        </a>
      ) : (
        project.title[lang]
      )}
    </h3>
    <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
      {project.stack.map((tech) => <li class="label">{tech}</li>)}
    </ul>

    <p class="mt-4 max-w-2xl text-sm">{project.summary[lang]}</p>
    <ul class="mt-3 max-w-2xl space-y-1.5 border-l border-rule pl-4">
      {project.points.map((point) => <li class="text-sm text-muted">{point[lang]}</li>)}
    </ul>

    {project.flow && (
      <figure class="mt-7">
        <ol class="flow grid gap-2 sm:grid-cols-5" data-flow aria-label={t('projects.flowLabel')}>
          {project.flow.map((stage, i) => (
            <li
              class="flow-node flex items-center border border-rule bg-bg px-3 py-2.5 text-xs leading-snug text-muted sm:min-h-16"
              style={`--i: ${i}`}
            >
              {stage[lang]}
            </li>
          ))}
        </ol>
        <figcaption class="label mt-3">{t('projects.flowLabel')}</figcaption>
      </figure>
    )}
  </div>
</article>

<script>
  // Run the flow once when it scrolls into view. Without JS it simply stays static.
  const flows = document.querySelectorAll<HTMLElement>('[data-flow]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-running');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    flows.forEach((el) => io.observe(el));
  }
</script>
