---
import type { Project } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
---

<article
  class="reveal grid gap-6 border-t border-rule py-10 lg:grid-cols-[7rem_1fr_minmax(0,22rem)] lg:gap-8"
>
  <p class="label lg:pt-2">{project.year}</p>

  <div class="max-w-xl">
    <h3 class="text-2xl tracking-tight sm:text-3xl">{project.title[lang]}</h3>
    <p class="mt-4 text-muted">{project.summary[lang]}</p>

    <ul class="mt-6 space-y-2">
      {project.points.map((point) => (
        <li class="flex gap-3 text-sm text-muted">
          <span class="text-fg" aria-hidden="true">—</span>
          <span>{point[lang]}</span>
        </li>
      ))}
    </ul>
  </div>

  <ul class="flex flex-wrap gap-x-3 gap-y-1 self-start lg:justify-end lg:pt-2">
    {project.stack.map((tech) => <li class="label">{tech}</li>)}
  </ul>
</article>
