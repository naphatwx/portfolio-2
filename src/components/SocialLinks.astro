---
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';
import { socials } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

// cards: full-width rows for the contact section. inline: glyph plus name for the hero.
interface Props {
  variant?: 'cards' | 'inline';
  class?: string;
}
const { variant = 'inline', class: className = '' } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

{variant === 'cards' ? (
  <ul class:list={['grid gap-3 sm:grid-cols-2', className]}>
    {socials.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="me noopener"
          class="group flex items-center gap-4 border border-rule p-4 text-left transition-colors hover:border-fg hover:bg-shade sm:p-5"
        >
          <SocialIcon id={s.id} class="size-6 shrink-0" />
          <span class="min-w-0 flex-1">
            <span class="block text-base tracking-tight sm:text-lg">{s.name}</span>
            <span class="block truncate text-xs text-muted sm:text-sm">{s.handle}</span>
          </span>
          <Icon
            id="arrow-up-right"
            class="size-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
          />
          <span class="sr-only">{t('a11y.newTab')}</span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <ul class:list={['flex items-center gap-5', className]}>
    {socials.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="me noopener"
          class="flex h-9 items-center gap-2 text-sm text-muted transition-colors hover:text-fg"
        >
          <SocialIcon id={s.id} class="size-4" />
          {s.name}
          <span class="sr-only">{t('a11y.newTab')}</span>
        </a>
      </li>
    ))}
  </ul>
)}
