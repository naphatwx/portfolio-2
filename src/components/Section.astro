---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-14 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-12 sm:px-10 sm:py-16">
    <h2 class="reveal mb-8 text-3xl tracking-tight sm:text-4xl">{title}</h2>
    <slot />
  </div>
</section>
