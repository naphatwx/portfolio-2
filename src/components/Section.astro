---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-14 border-b border-rule" aria-labelledby={`${id}-title`}>
  <div class="shell py-14 sm:py-20">
    <h2 id={`${id}-title`} class="section-title mb-8 sm:mb-10">{title}</h2>
    <slot />
  </div>
</section>
