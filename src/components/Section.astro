---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-14 border-b border-rule" aria-labelledby={`${id}-title`}>
  <div class="shell py-10 sm:py-14">
    <h2 id={`${id}-title`} class="section-title mb-6 sm:mb-8">{title}</h2>
    <slot />
  </div>
</section>
