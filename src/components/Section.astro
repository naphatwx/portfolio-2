---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  note?: string;
}
const { id, title, eyebrow, note } = Astro.props;
---

<section id={id} class="scroll-mt-16 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-28">
    {eyebrow && <p class="label reveal mb-10">{eyebrow}</p>}
    <div class="reveal mb-14 grid gap-6 lg:grid-cols-[1fr_minmax(0,24rem)] lg:items-start">
      <h2 class="text-4xl tracking-tight sm:text-6xl">{title}</h2>
      {note && <p class="text-sm text-muted lg:pt-3">{note}</p>}
    </div>
    <slot />
  </div>
</section>
