---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  note?: string;
}
const { id, title, eyebrow, note } = Astro.props;
---

<section id={id} class="scroll-mt-14 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-12 sm:px-10 sm:py-16">
    {eyebrow && <p class="label reveal mb-4">{eyebrow}</p>}
    <div class="reveal mb-8 grid gap-3 lg:grid-cols-[1fr_minmax(0,24rem)] lg:items-start">
      <h2 class="text-3xl tracking-tight sm:text-4xl">{title}</h2>
      {note && <p class="text-sm text-muted lg:pt-2">{note}</p>}
    </div>
    <slot />
  </div>
</section>
