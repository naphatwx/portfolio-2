---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { certificates } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Matched to certificates[].slug by filename. Thumbnails were unreadable, so
// each title links to the full-size scan instead.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/certificates/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const bySlug = new Map(
  Object.entries(files).map(([path, mod]) => [
    path.split('/').pop()!.replace(/\.[^.]+$/, ''),
    mod.default,
  ]),
);
const items = await Promise.all(
  certificates.map(async (cert) => {
    const img = bySlug.get(cert.slug);
    const full = img ? await getImage({ src: img, width: Math.min(img.width, 1600), format: 'webp' }) : null;
    return { ...cert, href: full?.src };
  }),
);
---

<div>
  <h3 class="text-base font-medium tracking-tight">{t('certs.title')}</h3>
  <ul class="mt-3 border-t border-rule">
    {items.map((cert) => (
      <li class="border-b border-rule py-2.5">
        {cert.href ? (
          <a href={cert.href} class="text-sm hover:underline">{cert.title[lang]}</a>
        ) : (
          <span class="text-sm">{cert.title[lang]}</span>
        )}
        <p class="label mt-0.5">{cert.issuer} · {cert.year}</p>
      </li>
    ))}
  </ul>
</div>
