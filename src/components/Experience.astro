---
import { experience } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="experience" class="scroll-mt-14 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-12 sm:px-10 sm:py-16">
    <h2 class="reveal mb-8 text-3xl tracking-tight sm:text-4xl">{t('exp.title')}</h2>

    <ol>
      {experience.map((role) => (
        <li class="reveal grid gap-4 border-t border-rule py-6 lg:grid-cols-[15rem_1fr] lg:gap-8">
          <div class="lg:sticky lg:top-20 lg:self-start">
            <h3 class="text-lg tracking-tight sm:text-xl">{role.company}</h3>
            <p class="mt-1 text-sm">{role.title[lang]}</p>
            <p class="label mt-1">{role.period[lang]}</p>

            <ul class="mt-3 flex flex-wrap gap-1.5">
              {role.tags.map((tag) => (
                <li class="label border border-rule px-2 py-0.5">{tag}</li>
              ))}
            </ul>
          </div>

          <div>
            <p class="text-sm text-muted">{role.detail[lang]}</p>

            <dl class="mt-4">
              {role.points.map((point) => (
                <div class="grid gap-0.5 border-t border-rule py-2.5 sm:grid-cols-[14rem_1fr] sm:gap-8">
                  <dt class="label sm:pt-1">{point.label[lang]}</dt>
                  <dd class="text-sm text-muted">{point.text[lang]}</dd>
                </div>
              ))}
            </dl>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
