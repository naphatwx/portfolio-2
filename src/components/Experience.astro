---
import Section from './Section.astro';
import { experience } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="experience" title={t('exp.title')}>
  <ol>
    {experience.map((role, i) => (
      <li class="grid gap-4 border-t border-rule py-7 lg:grid-cols-[18rem_1fr] lg:gap-10">
        <div class="lg:sticky lg:top-20 lg:self-start">
          <h3 class="text-lg font-medium tracking-tight sm:text-xl">{role.company}</h3>
          <p class="mt-1 text-sm">{role.title[lang]}</p>
          <p class="label mt-1.5 flex items-center gap-2">
            {i === 0 && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>}
            {role.period[lang]}
          </p>

          <ul class="mt-3 flex flex-wrap gap-1.5">
            {role.tags.map((tag) => (
              <li class="label border border-rule px-2 py-0.5">{tag}</li>
            ))}
          </ul>
        </div>

        <div>
          <p class="max-w-2xl text-sm">{role.detail[lang]}</p>

          <dl class="mt-4">
            {role.points.map((point) => (
              <div class="grid gap-1 border-t border-rule py-3 sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="label sm:pt-1">{point.label[lang]}</dt>
                <dd class="text-sm text-muted">{point.text[lang]}</dd>
              </div>
            ))}
          </dl>
        </div>
      </li>
    ))}
  </ol>
</Section>
