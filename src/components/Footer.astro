---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { contact, person } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const year = new Date().getFullYear();

const links = [
  { href: home, label: t('nav.home') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#certificates`, label: t('nav.certificates') },
];
---

<footer class="bg-shade">
  <div class="mx-auto max-w-7xl px-6 py-8 sm:px-10">
    <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-center">
      <nav>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {links.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-muted transition-colors hover:text-fg">{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a
        href={`mailto:${contact.email}`}
        class="text-lg tracking-tight underline decoration-1 underline-offset-6 hover:no-underline sm:text-xl"
      >
        {contact.email}
      </a>
    </div>

    <div
      class="mt-6 flex flex-col gap-2 border-t border-rule pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="label">© {year} {person.name} — {t('footer.rights')}</p>
      <div class="flex items-center gap-6 text-sm">
        <a href={contact.github} class="text-muted hover:text-fg" rel="me noopener">GitHub</a>
        <a href={contact.linkedin} class="text-muted hover:text-fg" rel="me noopener">LinkedIn</a>
        <span class="label hidden sm:inline">{t('footer.builtWith')}</span>
      </div>
    </div>
  </div>
</footer>
