---
import Icon from './Icon.astro';
import { person } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-shade">
  <div class="shell flex flex-col items-center justify-between gap-2 py-6 sm:flex-row">
    <p class="text-xs text-muted">© {year} {person.name}</p>
    <a href="#top" class="inline-flex h-9 items-center gap-2 text-xs text-muted transition-colors hover:text-fg">
      {t('footer.top')}
      <Icon id="arrow-up" class="size-3.5" />
    </a>
  </div>
</footer>
