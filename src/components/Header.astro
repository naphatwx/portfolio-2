---
import LangSwitch from './LangSwitch.astro';
import SocialIcon from './SocialIcon.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { contact } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);

const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#certificates`, label: t('nav.certificates') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-8 px-6 sm:px-10">
    <a href={home} aria-label="Home" class="shrink-0">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M12 2 3 8v8l9 6 9-6V8z" />
        <path d="M12 8v8" />
      </svg>
    </a>

    <nav class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="text-sm text-muted transition-colors hover:text-fg">{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <div class="flex items-center gap-1">
        <a
          href={`mailto:${contact.email}`}
          aria-label={t('nav.email')}
          title={t('nav.email')}
          class="flex items-center border border-rule p-1.5 text-muted transition-colors hover:text-fg"
        >
          <SocialIcon id="email" class="size-4" />
        </a>
        <SocialLinks variant="icons" />
      </div>
      <LangSwitch />
      <ThemeToggle />
    </div>
  </div>
</header>
