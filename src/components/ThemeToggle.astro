---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  id="theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label={t('theme.dark')}
  class="flex size-9 items-center justify-center border border-rule text-muted transition-colors hover:text-fg"
>
  <Icon id="sun" class="hidden size-4 dark:block" />
  <Icon id="moon" class="size-4 dark:hidden" />
</button>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const sync = () => btn?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
  sync();
  btn?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    // Storage can throw in private mode; the toggle still works for this visit.
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    sync();
  });
</script>
