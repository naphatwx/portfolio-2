---
import SocialLinks from './SocialLinks.astro';
import { contact } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="scroll-mt-14 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-14 sm:px-10 sm:py-20">
    <h2 class="reveal mx-auto max-w-3xl text-center text-3xl leading-tight tracking-tight sm:text-4xl">
      {t('cta.title')}
    </h2>
    <p class="reveal mx-auto mt-4 max-w-md text-center text-sm text-muted">{t('cta.body')}</p>

    <div class="reveal mx-auto mt-10 max-w-2xl">
      <a
        href={`mailto:${contact.email}`}
        class="group flex items-center gap-4 border border-fg bg-fg p-4 text-bg transition-opacity hover:opacity-85 sm:p-5"
      >
        <svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="2.5" y="4.5" width="19" height="15" />
          <path d="m2.5 6 9.5 7 9.5-7" />
        </svg>
        <span class="min-w-0 flex-1">
          <span class="label text-bg/70">{t('cta.emailLabel')}</span>
          <span class="mt-0.5 block truncate text-base tracking-tight sm:text-xl">{contact.email}</span>
        </span>
        <span class="shrink-0 transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
      </a>

      <p class="label mt-8 text-center">{t('social.elsewhere')}</p>
      <SocialLinks variant="cards" class="mt-3" />
    </div>
  </div>
</section>
