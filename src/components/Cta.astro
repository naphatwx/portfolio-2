---
import { contact } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="scroll-mt-14 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-14 text-center sm:px-10 sm:py-20">
    <h2 class="reveal mx-auto max-w-3xl text-3xl leading-tight tracking-tight sm:text-4xl">
      {t('cta.title')}
    </h2>
    <p class="reveal mx-auto mt-4 max-w-md text-sm text-muted">{t('cta.body')}</p>

    <a
      href={`mailto:${contact.email}`}
      class="reveal mt-8 inline-flex items-center gap-2 text-lg tracking-tight underline decoration-1 underline-offset-6 hover:no-underline sm:text-2xl"
    >
      {contact.email}<span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
