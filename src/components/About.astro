---
import { aboutPoints, education, skills } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="scroll-mt-16 border-b border-rule">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-28">
    <p class="label reveal mb-10">{t('about.eyebrow')}</p>

    <div class="grid gap-14 lg:grid-cols-[1fr_minmax(0,22rem)]">
      <div>
        <h2 class="reveal max-w-2xl text-3xl leading-tight tracking-tight sm:text-5xl">
          {t('about.lead')}
        </h2>

        <ul class="mt-12 max-w-xl space-y-6">
          {aboutPoints.map((point, i) => (
            <li class="reveal flex gap-5">
              <span class="label shrink-0 pt-1.5">0{i + 1}</span>
              <p class="text-muted">{point[lang]}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Only boxed element on the page: the degree earns the emphasis. -->
      <div class="reveal self-start border border-rule bg-shade p-8">
        <p class="label">{t('about.education')}</p>
        <p class="mt-4 text-4xl leading-none tracking-tight">{education.school}</p>
        <p class="mt-3 text-sm">{education.schoolFull[lang]}</p>
        <p class="mt-4 text-sm text-muted">{education.degree[lang]}</p>
        <p class="label mt-4">{education.period}</p>
      </div>
    </div>

    <!-- Full width below the grid: wide rows keep the stack short. -->
    <div class="reveal mt-20">
      <h3 class="label mb-5">{t('skills.title')}</h3>
      <dl class="grid border-t border-rule sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((group) => (
          <div class="border-b border-rule py-4 sm:pr-8">
            <dt class="label">{group.group[lang]}</dt>
            <dd class="mt-2 text-sm">{group.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
