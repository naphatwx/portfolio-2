---
import Section from './Section.astro';
import { aboutPoints, education, skills } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="about" title={t('about.title')}>
  <div class="grid gap-8 lg:grid-cols-[1fr_minmax(0,19rem)]">
    <div>
      <div class="max-w-xl space-y-3 text-sm text-muted">
        {aboutPoints.map((point, i) => (
          <p class:list={[i === 0 && 'text-base text-fg sm:text-lg']}>{point[lang]}</p>
        ))}
      </div>

      <h3 class="mt-8 mb-3 text-base font-medium tracking-tight">{t('skills.title')}</h3>
      <dl class="border-t border-rule">
        {skills.map((group) => (
          <div class="grid gap-1 border-b border-rule py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="label sm:pt-1">{group.group[lang]}</dt>
            <dd class="text-sm">{group.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </div>

    <aside class="self-start">
      <div class="border border-rule bg-shade p-5">
        <h3 class="label">{t('about.education')}</h3>
        <p class="mt-2 text-lg leading-snug tracking-tight">{education.schoolFull[lang]}</p>
        <p class="mt-2 text-sm text-muted">{education.degree[lang]}</p>
        <p class="label mt-2">{education.period}</p>
      </div>
    </aside>
  </div>
</Section>
