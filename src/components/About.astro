---
import { aboutPoints, education, skills } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="scroll-mt-14 border-b border-rule">
  <div class="shell py-12 sm:py-16">
    <p class="label reveal mb-4">{t('about.eyebrow')}</p>

    <div class="grid gap-8 lg:grid-cols-[1fr_minmax(0,22rem)]">
      <div>
        <h2 class="reveal max-w-2xl text-2xl leading-snug tracking-tight sm:text-3xl">
          {t('about.lead')}
        </h2>

        <ul class="mt-6 max-w-xl space-y-3">
          {aboutPoints.map((point, i) => (
            <li class="reveal flex gap-4">
              <span class="label shrink-0 pt-1">0{i + 1}</span>
              <p class="text-sm text-muted">{point[lang]}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Only boxed element on the page: the degree earns the emphasis. -->
      <div class="reveal self-start border border-rule bg-shade p-5">
        <p class="label">{t('about.education')}</p>
        <p class="mt-2 text-lg leading-snug tracking-tight">{education.schoolFull[lang]}</p>
        <p class="mt-2 text-sm text-muted">{education.degree[lang]}</p>
        <p class="label mt-2">{education.period}</p>
      </div>
    </div>

    <!-- Full width below the grid: wide rows keep the stack short. -->
    <div class="reveal mt-10">
      <h3 class="label mb-3">{t('skills.title')}</h3>
      <dl class="grid border-t border-rule sm:grid-cols-2 lg:grid-cols-3">
        {skills.map((group) => (
          <div class="border-b border-rule py-2.5 sm:pr-8">
            <dt class="label">{group.group[lang]}</dt>
            <dd class="mt-1 text-sm">{group.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
