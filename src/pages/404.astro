---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Naphat Wattanarattanakul">
  <section class="border-b border-rule">
    <div class="shell py-24 sm:py-32">
      <h1 class="section-title">This page doesn't exist.</h1>
      <p class="mt-4 max-w-md text-sm text-muted">
        Error 404. The link may be old or mistyped. <span lang="th">ไม่พบหน้าที่คุณกำลังหา</span>
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/" class="inline-flex h-9 items-center bg-accent px-4 text-sm font-medium text-on-accent transition-opacity hover:opacity-90">Go to the homepage</a>
        <a href="/th/" lang="th" class="inline-flex h-9 items-center border border-rule px-4 text-sm font-medium transition-colors hover:border-fg">กลับหน้าแรก</a>
      </div>
    </div>
  </section>
</Base>
